# Solo para desarrollo local (npm run dev). En producción usa public/config.js.
# Supabase Cloud → Project Settings → API  (URL y clave anon / publishable)
# Supabase local → `npx supabase start` imprime estos valores.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo para los scripts de Node (scripts/*.mjs). NUNCA con prefijo VITE_ y NUNCA en el navegador.
# SUPABASE_SERVICE_ROLE_KEY=...
