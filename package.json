{
  "name": "restopos",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de pedidos para restaurante: POS + cocina (KDS) + seguimiento + menú QR. Supabase Free + React.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/gen-image-index.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/gen-image-index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 8080",
    "typecheck": "tsc --noEmit",
    "test:db": "bash supabase/tests/run_tests.sh",
    "create-staff": "node scripts/create-staff.mjs",
    "backup": "node scripts/backup-json.mjs",
    "images": "node scripts/gen-image-index.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.77.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.0",
    "vite": "^8.3.8"
  }
}
